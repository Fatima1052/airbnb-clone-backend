# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=5000

# Comma-separated list of frontend origins allowed to call this API.
# Include your local dev server and your deployed Vercel URL.
CORS_ORIGIN=http://localhost:3000,https://airbnb-clone-steel-tau.vercel.app

# --- Database ---
# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers).
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/airbnb-clone
MONGODB_URI=mongodb://127.0.0.1:27017/airbnb-clone

# --- Firebase Admin (verifies the ID token the frontend sends) ---
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# That JSON file has these three fields — copy them here.
# FIREBASE_PRIVATE_KEY must keep its \n escapes as a single line, in quotes.
FIREBASE_PROJECT_ID=airbnb-clone-2e23c
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
